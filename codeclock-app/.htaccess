# Nothing in this folder (config, logs, sessions, SQL, PHP libraries) is ever meant to be
# served over HTTP. codeclock-app/ should sit OUTSIDE the web root; this file is only a
# safety net for the day it ends up inside it by mistake.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
